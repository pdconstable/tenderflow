# Tender OS — environment variable example.
#
# Copy the relevant values into .env.local (gitignored) for local development,
# and configure them per-environment in Vercel. NEVER commit real secrets.
# This file contains variable NAMES and safe placeholders only.

# --- Public (browser-safe; MUST be prefixed NEXT_PUBLIC_) --------------------
# Supabase project connection for the client boundaries.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# --- Deployment environment override (optional) ------------------------------
# On Vercel, VERCEL_ENV is set automatically and takes precedence.
# For non-Vercel hosts you may set APP_ENV to one of: local | preview | production.
# APP_ENV="local"

# --- Not yet required --------------------------------------------------------
# No server-only secrets are required by the current foundation.
# Stripe, Resend, Vercel AI Gateway, Companies House and any Supabase
# service-role key will be added here when those integrations are implemented,
# each with a manual-setup disclosure.
